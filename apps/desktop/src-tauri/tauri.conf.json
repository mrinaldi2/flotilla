{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flotilla",
  "version": "0.23.0",
  "identifier": "com.manuelrinaldi.flotilla",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Flotilla",
        "create": false,
        "width": 1280,
        "height": 800,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "resources": {
      "../../../third-party/DESKTOP_NOTICES.txt": "THIRD_PARTY_NOTICES.txt",
      "../../../LICENSE": "LICENSE"
    },
    "externalBin": [
      "binaries/flotillad"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  }
}
